PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce_db
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
STORE_NAME=Everyday Market
STORE_CURRENCY=INR

# Optional online payment providers. Cash on delivery works without these.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: seed.js creates this first administrator account when both are set.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
